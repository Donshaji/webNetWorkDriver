<Window x:Class="webNetWorkDriver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:webNetWorkDriver"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="AliceBlue">
            <StackPanel HorizontalAlignment="Left" Margin="4">
                <StackPanel Margin="3,0">
                    <TextBlock Text="Host"/>
                    <TextBox Width="90" ></TextBox>
                </StackPanel>

            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Background="AntiqueWhite"></Grid>
    </Grid>
</Window>
